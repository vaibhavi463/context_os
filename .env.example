# ContextOS Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
PORT=8000
MCP_PORT=8001

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL 16 with pgvector)
POSTGRES_USER=contextos
POSTGRES_PASSWORD=contextos_dev_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=contextos_db
DATABASE_URL=postgresql+asyncpg://contextos:contextos_dev_pass@localhost:5432/contextos_db

# Cache & Queues (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# External Integrations
GITHUB_TOKEN=your_github_personal_access_token_optional
